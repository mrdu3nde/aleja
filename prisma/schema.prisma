generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                String        @id @default(uuid())
  name              String
  // Optional: the owner often books someone she only has a phone number for.
  // Postgres allows many NULLs under a unique index, so this stays safe.
  email             String?       @unique
  phone             String?
  // Last 10 digits of `phone`, kept in sync on write. Lets us match and search
  // by phone regardless of how it was typed. See src/lib/phone.ts
  phoneNormalized   String?
  contactPreference String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointments      Appointment[]

  @@index([phoneNormalized])
}

model Appointment {
  id                String    @id @default(uuid())
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName        String
  clientEmail       String
  clientPhone       String?
  service           String
  preferredDate     String?
  // "HH:MM" 24h. Set by the owner when booking; the client only confirms it.
  preferredTime     String?
  /// Snapshot of the service duration at booking time, so later edits to the
  /// service never rewrite how long a past appointment took.
  durationMinutes   Int?
  status            String    @default("pending")
  message           String?
  source            String    @default("website")

  // What the service costs in total. The deposit is an advance against this,
  // and `payments` records whatever is collected afterwards.
  servicePrice      Decimal?  @db.Decimal(10, 2)
  payments          Payment[]
  depositRequired   Boolean   @default(true)
  depositAmount     Decimal?  @default(20.00) @db.Decimal(10, 2)
  depositStatus     String    @default("pending")
  depositReceivedAt DateTime?

  // Share-to-confirm flow: the owner pre-books, shares an opaque link, and the
  // client fills in whatever is still missing. Token is random (not derived from
  // ids or dates) so a link cannot be guessed from another one.
  shareToken        String?   @unique
  sharedAt          DateTime?
  clientConfirmedAt DateTime?
  confirmationSeen  Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// A service the studio offers. Editable from the studio: add, remove, reorder,
/// price and photo. The translated title/description stay in `Content` under
/// `services_section.<slug>.*` so the public site keeps its two languages.
model Service {
  id        String   @id @default(uuid())
  /// Stable key used for the Content lookups. Never reused.
  slug      String   @unique
  /// Label stored on appointments and shown in the studio.
  name      String
  price     Decimal? @db.Decimal(10, 2)
  /// How long a booking of this service occupies the chair.
  durationMinutes Int  @default(60)
  /// Vercel Blob URL. Falls back to `icon` when empty.
  imageUrl  String?
  /// lucide icon name, used when there is no photo yet.
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Money collected for an appointment after the deposit — a log rather than a
/// single field, so a client can settle in parts and each entry keeps its own
/// method and date.
model Payment {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(10, 2)
  method        String      @default("cash")
  note          String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

/// Web push endpoints for the owner's devices. One row per browser/device.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())
}

model Content {
  key       String   @id
  locale    String   @default("en")
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

/// Recurring weekly opening hours. One row per weekday she works.
/// Times are minutes from midnight, which makes overlap maths trivial.
model Availability {
  id           String  @id @default(uuid())
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int     @unique
  startMinutes Int
  endMinutes   Int
  active       Boolean @default(true)
}

/// A single day off: holiday, vacation, or anything that overrides the weekly
/// hours. Stored as "YYYY-MM-DD" to match how appointment dates are kept.
model BlockedDate {
  date   String  @id
  reason String?
}
