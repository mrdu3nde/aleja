generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                String        @id @default(uuid())
  name              String
  // Optional: the owner often books someone she only has a phone number for.
  // Postgres allows many NULLs under a unique index, so this stays safe.
  email             String?       @unique
  phone             String?
  // Last 10 digits of `phone`, kept in sync on write. Lets us match and search
  // by phone regardless of how it was typed. See src/lib/phone.ts
  phoneNormalized   String?
  contactPreference String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointments      Appointment[]

  @@index([phoneNormalized])
}

model Appointment {
  id                String    @id @default(uuid())
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName        String
  clientEmail       String
  clientPhone       String?
  service           String
  preferredDate     String?
  // "HH:MM" 24h. Set by the owner when booking; the client only confirms it.
  preferredTime     String?
  /// Snapshot of the service duration at booking time, so later edits to the
  /// service never rewrite how long a past appointment took.
  durationMinutes   Int?
  status            String    @default("pending")
  message           String?
  source            String    @default("website")

  // What the service costs in total. The deposit is an advance against this,
  // and `payments` records whatever is collected afterwards.
  servicePrice      Decimal?  @db.Decimal(10, 2)
  payments          Payment[]
  depositRequired   Boolean   @default(true)
  depositAmount     Decimal?  @default(20.00) @db.Decimal(10, 2)
  depositStatus     String    @default("pending")
  depositReceivedAt DateTime?

  // Share-to-confirm flow: the owner pre-books, shares an opaque link, and the
  // client fills in whatever is still missing. Token is random (not derived from
  // ids or dates) so a link cannot be guessed from another one.
  shareToken        String?   @unique
  sharedAt          DateTime?
  clientConfirmedAt DateTime?
  confirmationSeen  Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// A service the studio offers. Editable from the studio: add, remove, reorder,
/// price and photo. The translated title/description stay in `Content` under
/// `services_section.<slug>.*` so the public site keeps its two languages.
model Service {
  id        String   @id @default(uuid())
  /// Stable key used for the Content lookups. Never reused.
  slug      String   @unique
  /// Label stored on appointments and shown in the studio.
  name      String
  price     Decimal? @db.Decimal(10, 2)
  /// How long a booking of this service occupies the chair.
  durationMinutes Int  @default(60)
  /// Vercel Blob URL. Falls back to `icon` when empty.
  imageUrl  String?
  /// lucide icon name, used when there is no photo yet.
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Money collected for an appointment after the deposit — a log rather than a
/// single field, so a client can settle in parts and each entry keeps its own
/// method and date.
model Payment {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(10, 2)
  method        String      @default("cash")
  note          String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

/// Web push endpoints for the owner's devices. One row per browser/device.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())
}

model Content {
  key       String   @id
  locale    String   @default("en")
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

/// Recurring weekly opening hours. One row per weekday she works.
/// Times are minutes from midnight, which makes overlap maths trivial.
model Availability {
  id           String  @id @default(uuid())
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int     @unique
  startMinutes Int
  endMinutes   Int
  active       Boolean @default(true)
}

/// A single day off: holiday, vacation, or anything that overrides the weekly
/// hours. Stored as "YYYY-MM-DD" to match how appointment dates are kept.
model BlockedDate {
  date   String  @id
  reason String?
}

/// Una foto de algo que la dueña escribió a mano. Un modelo de visión la
/// transcribe y el texto queda aquí para poder leerlo desde el desarrollo:
/// es el buzón por donde ella pide cambios sin tener que teclearlos.
model Note {
  id         String    @id @default(uuid())
  /// Título corto que genera el modelo, para listar sin abrir cada nota.
  title      String?
  /// Lo que el modelo oyó, palabra por palabra. Nunca se sobrescribe: es la
  /// evidencia de lo que ella pidió, aunque después corrija el texto.
  transcript String?
  /// Su corrección a mano cuando el modelo oyó mal. Si existe, manda esta.
  editedText String?
  /// "voice" | "text" — cómo la dictó. El audio no se guarda: se transcribe al
  /// vuelo y se descarta, así que esto es lo único que queda de su origen.
  source     String    @default("voice")
  /// "new" | "read" | "needs_info" | "done". "needs_info" lo pongo yo desde
  /// código cuando la nota no me alcanza para implementar lo que pide.
  status     String    @default("new")
  /// Transcripción del audio: "pending" | "ok" | "failed".
  aiStatus   String    @default("pending")
  /// Motivo del fallo, para depurar sin ir a los logs de Vercel.
  aiError    String?
  /// Modelo que transcribió. Si mañana se cambia, se sabe qué oyó qué.
  aiModel    String?
  /// Foto de respaldo, opcional. NO se transcribe: está para mirarla cuando el
  /// texto no basta (un boceto de pantalla, una captura, un papel viejo).
  imageUrl   String?
  /// Respaldo para cuando Blob no está configurado: la foto ya reducida en el
  /// navegador, guardada como data URL. Se excluye a propósito del listado.
  imageData  String?
  /// Cuándo quedó resuelta desde código.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages   NoteMessage[]

  @@index([status, createdAt])
}

/// La conversación sobre una nota. Yo pregunto cuando algo no se entiende y
/// ella contesta desde el panel, por voz o escribiendo. Sin esto, cada duda
/// tendría que pasar por su esposo.
model NoteMessage {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  /// "claude" (lo escribo desde código) | "owner" (lo contesta ella).
  author    String
  body      String
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

/// Llave de acceso (passkey) que la dueña registró desde un dispositivo suyo.
/// Aquí solo vive la llave PÚBLICA: su huella y su cara nunca salen del
/// teléfono, así que esta tabla no contiene ningún dato biométrico.
model Credential {
  id           String    @id @default(uuid())
  /// Identificador que emite el autenticador, en base64url.
  credentialId String    @unique
  publicKey    Bytes
  /// Contador anti-repetición. Los passkeys sincronizados reportan siempre 0;
  /// las llaves físicas sí lo incrementan, y ahí es donde sirve.
  counter      BigInt    @default(0)
  /// Transportes ("internal", "hybrid"…) en JSON, para que el navegador
  /// ofrezca el método correcto en cada equipo.
  transports   String?
  /// Nombre con el que ella lo reconoce: "iPhone de Ale".
  deviceName   String
  /// Si el passkey se sincroniza (iCloud / Google), sirve en sus otros equipos.
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}
